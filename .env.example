# Copy this file to .env.local and fill in the values. Never commit .env.local.

# TASY dropshipping API (tyres) — https://api.tasy.cz/swagger/index.html
# Leave TASY_USERNAME / TASY_PASSWORD empty to use the demo tyre catalogue.
TASY_API_URL=https://api.tasy.cz
TASY_USERNAME=
TASY_PASSWORD=
# Orders are sent as test orders unless this is "false". Switch only after a successful test order.
TASY_TEST_MODE=true
